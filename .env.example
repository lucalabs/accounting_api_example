# Optional. The credential form on the page is the primary way in — this file
# just prefills it so you do not retype things after a restart.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# The Luca instance to talk to. Prefixed because a bare HOST is the bind address
# to much of the Node ecosystem, and one exported in your shell would win.
#
# Only the host is configured: the authorize, token and revocation endpoints are
# read from this host's /.well-known/oauth-authorization-server document.
HOST=https://go.lucaregnskap.no

# From your OAuth application in Luca.
CLIENT_ID=

# Leave blank to run as a public client. OAuth 2.1 allows a client with no
# secret — PKCE is what proves the token exchange came from whoever started the
# flow — which is how a mobile or single-page integration works.
CLIENT_SECRET=

# Space-separated scopes to ask for: accounting.read to read, and
# accounting.write to also make changes. You may only ask for the scopes your
# OAuth application is registered for; asking for more is refused with
# invalid_scope.
SCOPE=accounting.read

# Port this example listens on. Changing it changes the redirect URI, which
# must stay in sync with what you registered in Luca — Luca compares them
# character for character.
PORT=8080

# Only needed if the redirect URI you registered is not
# http://localhost:8080/oauth/callback — behind a tunnel, for instance.
# REDIRECT_URI=https://your-tunnel.example.com/oauth/callback

# Signs the session cookie. Left unset, a random one is generated each boot,
# which means restarting the server logs you out. That is a fine default here.
# SESSION_SECRET=
