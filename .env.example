# Optional. The credential form on the page is the primary way in — this file
# just prefills it so you do not retype things after a restart.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# The Luca instance to talk to. Prefixed because a bare HOST is the bind address
# to much of the Node ecosystem, and one exported in your shell would win.
HOST=https://go.lucaregnskap.no

# From your OAuth application in Luca.
CLIENT_ID=
CLIENT_SECRET=

# Port this example listens on. Changing it changes the redirect URI, which
# must stay in sync with what you registered in Luca.
PORT=8080

# Only needed if the redirect URI you registered is not
# http://localhost:8080/oauth/callback — behind a tunnel, for instance.
# REDIRECT_URI=https://your-tunnel.example.com/oauth/callback

# Signs the session cookie. Left unset, a random one is generated each boot,
# which means restarting the server logs you out. That is a fine default here.
# SESSION_SECRET=
