<%
  // Every link out of the sidebar carries the editor's contents with it, so
  // reading the docs never costs you the query you were writing.
  const linkState = { q: search, query, variables };

  // A null drops the parameter rather than sending the word "null" — which is
  // how "Try it" asks for a generated example instead of keeping the editor.
  const href = (extra) => {
    const params = new URLSearchParams();

    for (const [key, value] of Object.entries({ ...linkState, ...extra })) {
      if (value !== null && value !== undefined) params.set(key, value);
    }

    return `/api?${params}`;
  };

  const ref = (item) =>
    typeRef({
      rendered: item.returns ?? item.type,
      typeName: item.typeName,
      linkable: Boolean(schema && schema.types.has(item.typeName)),
      state: linkState,
    });
%>

<aside class="card sidebar">
  <div class="pane-head">
    <h2>Schema</h2>
    <a class="link-quiet" href="<%= href({ refresh: "1", type: type ? type.name : "" }) %>"
       title="Fetch the schema again">Reload</a>
  </div>

  <% if (schemaError) { %>
    <p class="empty">Could not read the schema.</p>
    <p class="hint"><%= schemaError %></p>
  <% } else if (type) { %>
    <%- include("type-doc", { type, ref, href }) %>
  <% } else { %>
    <form method="get" action="/api" class="search">
      <input type="hidden" name="query" value="<%= query %>">
      <input type="hidden" name="variables" value="<%= variables %>">
      <input type="search" name="q" value="<%= search %>" placeholder="Search fields…"
             spellcheck="false" autocomplete="off">
    </form>

    <% const groups = [
         { label: "Queries", fields: filtered.queries },
         { label: "Mutations", fields: filtered.mutations },
       ]; %>

    <% if (!groups.some((g) => g.fields.length)) { %>
      <p class="empty">Nothing matches “<%= search %>”.</p>
    <% } %>

    <% for (const group of groups) { %>
      <% if (group.fields.length) { %>
        <details open>
          <summary><%= group.label %> <span class="muted"><%= group.fields.length %></span></summary>

          <ul class="schema">
            <% for (const field of group.fields) { %>
              <li>
                <div class="sig">
                  <a class="try" href="<%= href({ field: field.name, query: null, variables: null }) %>">Try it</a>
                  <%- include("signature", { field, ref }) %>
                </div>
                <% if (field.description) { %>
                  <p class="sig-desc"><%= field.description %></p>
                <% } %>
              </li>
            <% } %>
          </ul>
        </details>
      <% } %>
    <% } %>
  <% } %>
</aside>
